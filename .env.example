# Root example env file — shows every variable the stack needs.
# Each service also has its own services/<name>/.env.example with just its own vars
# (Prisma and Fastify read .env from the service's own directory, not the repo root).

# --- services/backend-auth ---
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public
AUTH_PORT=3001

# --- services/backend-game ---
GAME_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/game_db?schema=public
GAME_PORT=3002

# --- services/frontend (baked in at Vite build time) ---
VITE_AUTH_API_URL=http://localhost:3001
VITE_GAME_API_URL=http://localhost:3002
